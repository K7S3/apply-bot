  "difficulty": "medium",
  "statement": "Given a list of intervals [start, end], merge all overlapping intervals and return the merged list.\n\nTwo intervals overlap if one starts at or before the other ends.\n\nExample: [[1,3],[2,6],[8,10],[15,18]] -> [[1,6],[8,10],[15,18]]",
  "function": "solve(intervals)",
  "compare": "sorted_nested",
