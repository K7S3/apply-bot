# .pypirc template for candid releases
#
# Copy this file to ~/.pypirc and fill in YOUR OWN values.
# Never commit a real .pypirc (with credentials) to git.
#
#   cp .pypirc.example ~/.pypirc
#   chmod 600 ~/.pypirc
#
# Prefer API tokens over passwords:
#   https://pypi.org/manage/account/token/
# A token looks like: pypi-AgEIcHlwaS5vcmcCJ...

[distutils]
index-servers =
    pypi
    testpypi

[pypi]
repository = https://upload.pypi.org/legacy/
username = __token__
password = YOUR_PYPI_API_TOKEN_HERE

[testpypi]
repository = https://test.pypi.org/legacy/
username = __token__
password = YOUR_TESTPYPI_API_TOKEN_HERE
